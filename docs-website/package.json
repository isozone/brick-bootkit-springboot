{
  "name": "docs-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-config-index": "node ./scripts/generate-config-index.mjs",
    "generate-config-summary": "node ./scripts/generate-config-summary.mjs",
    "verify-docs:sources": "node ./scripts/verify-doc-sources.mjs",
    "verify-docs:coverage": "node ./scripts/verify-config-coverage.mjs",
    "verify-docs": "npm run verify-docs:sources && npm run verify-docs:coverage",
    "build": "npm run verify-docs && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "vite": "^7.2.4"
  }
}
