<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.5</version>
        <relativePath/>
    </parent>


    <groupId>com.example</groupId>
    <artifactId>springboot-monitor-plus</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>springboot-monitor-plus</name>
    <description>Spring Boot 3.5.5 springboot-monitor-plus</description>



    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <!--        <dependency>-->
        <!--            <groupId>com.zqzqq</groupId>-->
        <!--            <artifactId>spring-boot3-brick-bootkit-core</artifactId>-->
        <!--            <version>4.0.1</version>-->
        <!--        </dependency>-->

        <!--        <dependency>-->
        <!--            <groupId>com.zqzqq</groupId>-->
        <!--            <artifactId>spring-boot3-brick-bootkit-common</artifactId>-->
        <!--            <version>4.0.1</version>-->
        <!--        </dependency>-->

        <dependency>
            <groupId>com.zqzqq.webDemo</groupId>
            <artifactId>spring-boot3-brick-bootkit-web-demo</artifactId>
            <version>4.0.4</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.zqzqq</groupId>
            <artifactId>spring-boot3-brick-bootkit-core</artifactId>
            <version>4.0.4</version>
        </dependency>


        <dependency>
            <groupId>com.zqzqq</groupId>
            <artifactId>spring-boot3-brick-bootkit-bootstrap</artifactId>
            <version>4.0.4</version>

        </dependency>


        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/**</include>
                </includes>
            </resource>
        </resources>



        <plugins>
            <plugin>
                <groupId>com.zqzqq</groupId>
                <artifactId>spring-boot3-brick-bootkit-maven-packager</artifactId>
                <version>4.0.4</version>
                <configuration>
                    <!--                    dev / prod-->
                    <mode>prod</mode>
                    <pluginInfo>
                        <id>demoTestUploadPlus</id>
                        <bootstrapClass>com.zqzqq.bootkits.web.demo.uplo.DemoTestUploadPlusApplication</bootstrapClass>
                        <version>0.0.3</version>
                        <provider>jove</provider>
                        <description>demoTestUploadPlusApplication</description>

                    </pluginInfo>
                    <prodConfig>
                        <packageType>jar</packageType>
                    </prodConfig>
                    <includeSystemScope>true</includeSystemScope>

                </configuration>

                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>

            </plugin>

        </plugins>
    </build>
</project>