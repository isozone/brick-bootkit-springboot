<?xml version="1.0" encoding="UTF-8"?>

<plugin>
    <name>Spring Boot Plugin Maven Packager</name>
    <groupId>com.zqzqq</groupId>
    <artifactId>spring-boot3-brick-bootkit-maven-packager</artifactId>
    <version>4.0.9</version>
    <goalPrefix>spring-boot3-brick-bootkit-packager</goalPrefix>
    <isolatedRealm>false</isolatedRealm>
    <inheritedByDefault>true</inheritedByDefault>
    <mojos>
        <mojo>
            <goal>repackage</goal>
            <description>Repackage plugin artifact.</description>
            <requiresDependencyResolution>compile+runtime</requiresDependencyResolution>
            <requiresDirectInvocation>false</requiresDirectInvocation>
            <requiresProject>true</requiresProject>
            <requiresReports>false</requiresReports>
            <aggregator>false</aggregator>
            <requiresOnline>false</requiresOnline>
            <inheritedByDefault>true</inheritedByDefault>
            <phase>package</phase>
            <implementation>com.zqzqq.bootkits.plugin.pack.RepackageMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <executionStrategy>once-per-session</executionStrategy>
            <since>3.0.0</since>
            <requiresDependencyCollection>compile+runtime</requiresDependencyCollection>
            <threadSafe>true</threadSafe>
            <parameters>
                <parameter>
                    <name>project</name>
                    <type>org.apache.maven.project.MavenProject</type>
                    <since>3.0.0</since>
                    <required>true</required>
                    <editable>false</editable>
                    <description>Current Maven project.</description>
                </parameter>
                <parameter>
                    <name>outputDirectory</name>
                    <type>java.io.File</type>
                    <since>3.0.0</since>
                    <required>true</required>
                    <editable>true</editable>
                    <description>Package output directory.</description>
                </parameter>
                <parameter>
                    <name>includes</name>
                    <type>java.util.List</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Included dependency definitions.</description>
                </parameter>
                <parameter>
                    <name>excludes</name>
                    <type>java.util.List</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Excluded dependency definitions.</description>
                </parameter>
                <parameter>
                    <name>skip</name>
                    <type>boolean</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Skip execution.</description>
                </parameter>
                <parameter>
                    <name>mode</name>
                    <type>string</type>
                    <since>3.0.0</since>
                    <required>true</required>
                    <editable>true</editable>
                    <description>Package mode: dev/prod/main. Default is dev.</description>
                </parameter>
                <parameter>
                    <name>pluginInfo</name>
                    <type>com.zqzqq.bootkits.plugin.pack.PluginInfo</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Plugin metadata.</description>
                </parameter>
                <parameter>
                    <name>loadMainResourcePattern</name>
                    <type>com.zqzqq.bootkits.plugin.pack.LoadMainResourcePattern</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Patterns for loading resources from main application.</description>
                </parameter>
                <parameter>
                    <name>devConfig</name>
                    <type>com.zqzqq.bootkits.plugin.pack.dev.DevConfig</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Configuration for dev package mode.</description>
                </parameter>
                <parameter>
                    <name>prodConfig</name>
                    <type>com.zqzqq.bootkits.plugin.pack.prod.ProdConfig</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Configuration for prod package mode.</description>
                </parameter>
                <parameter>
                    <name>mainConfig</name>
                    <type>com.zqzqq.bootkits.plugin.pack.main.MainConfig</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Configuration for main package mode.</description>
                </parameter>
                <parameter>
                    <name>loadToMain</name>
                    <type>com.zqzqq.bootkits.plugin.pack.LoadToMain</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Dependencies loaded into main application package.</description>
                </parameter>
                <parameter>
                    <name>encryptConfig</name>
                    <type>com.zqzqq.bootkits.plugin.pack.encrypt.EncryptConfig</type>
                    <since>3.0.1</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Encryption configuration.</description>
                </parameter>
                <parameter>
                    <name>includeSystemScope</name>
                    <type>boolean</type>
                    <since>3.0.2</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Whether to include dependencies with system scope.</description>
                </parameter>
            </parameters>
            <configuration>
                <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
                <outputDirectory implementation="java.io.File" default-value="${project.build.directory}"/>
                <skip implementation="boolean" default-value="false"/>
                <mode implementation="string" default-value="dev"/>
                <pluginInfo implementation="com.zqzqq.bootkits.plugin.pack.PluginInfo" />
                <loadMainResourcePattern implementation="com.zqzqq.bootkits.plugin.pack.LoadMainResourcePattern" />
                <includes implementation="java.util.List">${springboot-plugin.includes}</includes>
                <excludes implementation="java.util.List">${springboot-plugin.excludes}</excludes>
                <devConfig implementation="com.zqzqq.bootkits.plugin.pack.dev.DevConfig" />
                <prodConfig implementation="com.zqzqq.bootkits.plugin.pack.prod.ProdConfig" />
                <mainConfig implementation="com.zqzqq.bootkits.plugin.pack.main.MainConfig" />
                <loadToMain implementation="com.zqzqq.bootkits.plugin.pack.LoadToMain" />
                <encryptConfig implementation="com.zqzqq.bootkits.plugin.pack.encrypt.EncryptConfig" />
                <includeSystemScope implementation="boolean" default-value="true" />
            </configuration>
            <requirements>
                <requirement>
                    <role>org.apache.maven.project.MavenProjectHelper</role>
                    <field-name>projectHelper</field-name>
                </requirement>
            </requirements>
        </mojo>
        <mojo>
            <goal>prepare-meta</goal>
            <description>Prepare plugin metadata for standalone development and testing.</description>
            <requiresDependencyResolution>compile+runtime</requiresDependencyResolution>
            <requiresDirectInvocation>false</requiresDirectInvocation>
            <requiresProject>true</requiresProject>
            <requiresReports>false</requiresReports>
            <aggregator>false</aggregator>
            <requiresOnline>false</requiresOnline>
            <inheritedByDefault>true</inheritedByDefault>
            <phase>process-classes</phase>
            <implementation>com.zqzqq.bootkits.plugin.pack.PrepareMetaMojo</implementation>
            <language>java</language>
            <instantiationStrategy>per-lookup</instantiationStrategy>
            <executionStrategy>once-per-session</executionStrategy>
            <since>4.0.5</since>
            <requiresDependencyCollection>compile+runtime</requiresDependencyCollection>
            <threadSafe>true</threadSafe>
            <parameters>
                <parameter>
                    <name>project</name>
                    <type>org.apache.maven.project.MavenProject</type>
                    <since>3.0.0</since>
                    <required>true</required>
                    <editable>false</editable>
                    <description>Current Maven project.</description>
                </parameter>
                <parameter>
                    <name>outputDirectory</name>
                    <type>java.io.File</type>
                    <since>3.0.0</since>
                    <required>true</required>
                    <editable>true</editable>
                    <description>Package output directory.</description>
                </parameter>
                <parameter>
                    <name>includes</name>
                    <type>java.util.List</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Included dependency definitions.</description>
                </parameter>
                <parameter>
                    <name>excludes</name>
                    <type>java.util.List</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Excluded dependency definitions.</description>
                </parameter>
                <parameter>
                    <name>skip</name>
                    <type>boolean</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Skip execution.</description>
                </parameter>
                <parameter>
                    <name>mode</name>
                    <type>string</type>
                    <since>3.0.0</since>
                    <required>true</required>
                    <editable>true</editable>
                    <description>Package mode: dev/prod/main. Default is dev.</description>
                </parameter>
                <parameter>
                    <name>pluginInfo</name>
                    <type>com.zqzqq.bootkits.plugin.pack.PluginInfo</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Plugin metadata.</description>
                </parameter>
                <parameter>
                    <name>loadMainResourcePattern</name>
                    <type>com.zqzqq.bootkits.plugin.pack.LoadMainResourcePattern</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Patterns for loading resources from main application.</description>
                </parameter>
                <parameter>
                    <name>devConfig</name>
                    <type>com.zqzqq.bootkits.plugin.pack.dev.DevConfig</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Configuration for dev package mode.</description>
                </parameter>
                <parameter>
                    <name>prodConfig</name>
                    <type>com.zqzqq.bootkits.plugin.pack.prod.ProdConfig</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Configuration for prod package mode.</description>
                </parameter>
                <parameter>
                    <name>mainConfig</name>
                    <type>com.zqzqq.bootkits.plugin.pack.main.MainConfig</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Configuration for main package mode.</description>
                </parameter>
                <parameter>
                    <name>loadToMain</name>
                    <type>com.zqzqq.bootkits.plugin.pack.LoadToMain</type>
                    <since>3.0.0</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Dependencies loaded into main application package.</description>
                </parameter>
                <parameter>
                    <name>encryptConfig</name>
                    <type>com.zqzqq.bootkits.plugin.pack.encrypt.EncryptConfig</type>
                    <since>3.0.1</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Encryption configuration.</description>
                </parameter>
                <parameter>
                    <name>includeSystemScope</name>
                    <type>boolean</type>
                    <since>3.0.2</since>
                    <required>false</required>
                    <editable>true</editable>
                    <description>Whether to include dependencies with system scope.</description>
                </parameter>
            </parameters>
            <configuration>
                <project implementation="org.apache.maven.project.MavenProject" default-value="${project}"/>
                <outputDirectory implementation="java.io.File" default-value="${project.build.directory}"/>
                <skip implementation="boolean" default-value="false"/>
                <mode implementation="string" default-value="dev"/>
                <pluginInfo implementation="com.zqzqq.bootkits.plugin.pack.PluginInfo" />
                <loadMainResourcePattern implementation="com.zqzqq.bootkits.plugin.pack.LoadMainResourcePattern" />
                <includes implementation="java.util.List">${springboot-plugin.includes}</includes>
                <excludes implementation="java.util.List">${springboot-plugin.excludes}</excludes>
                <devConfig implementation="com.zqzqq.bootkits.plugin.pack.dev.DevConfig" />
                <prodConfig implementation="com.zqzqq.bootkits.plugin.pack.prod.ProdConfig" />
                <mainConfig implementation="com.zqzqq.bootkits.plugin.pack.main.MainConfig" />
                <loadToMain implementation="com.zqzqq.bootkits.plugin.pack.LoadToMain" />
                <encryptConfig implementation="com.zqzqq.bootkits.plugin.pack.encrypt.EncryptConfig" />
                <includeSystemScope implementation="boolean" default-value="true" />
            </configuration>
            <requirements>
                <requirement>
                    <role>org.apache.maven.project.MavenProjectHelper</role>
                    <field-name>projectHelper</field-name>
                </requirement>
            </requirements>
        </mojo>
    </mojos>
    <dependencies/>
</plugin>